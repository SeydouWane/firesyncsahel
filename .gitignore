.venv/
__pycache__/
*.pyc
.pytest_cache/
.claude/
.vercel/

# raw downloads and training caches: rebuilt with `python -m firesync build`
data/raw/
data/validation/*.parquet
data/validation/*.log
# processed tables: only the serving snapshot read by the web app is versioned
data/processed/*
!data/processed/availability_week.parquet
!data/processed/model_week.parquet
!data/processed/fine_week.parquet
!data/processed/detections.parquet
!data/processed/admin_1.geojson
!data/processed/admin_2.geojson
!data/processed/landcover_meta.json
# data/models/ (harmonised series, forecast) is versioned: it is the deployed snapshot

# local application database and session secret — never in the repo
data/app/
*.log

# generated by presentation/*.py
presentation/sahel_firms/
presentation/preview/
presentation/slides.html

# credentials never belong in the repo
.netrc
_netrc
.env
.env.*
